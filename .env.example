# ---- LLM (Llama via Ollama, client OpenAI-compatible) ----
# Ollama expose une API OpenAI-compatible sur /v1. Pour une API Llama hébergée,
# changer base_url, modèle et clé.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=ollama

# ---- Gemini Embedding 2 (un embedder parmi d'autres, désactivable) ----
USE_GEMINI=true
GEMINI_API_KEY=
GEMINI_DIM=768

# ---- Recherche web (tavily | brave) ----
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=

# ---- Embedders actifs (sous-ensemble de : clap, peav, gemma, gemini) ----
# gemma = EmbeddingGemma 2 (google/embeddinggemma-2), poids ouverts, tourne en local : rien ne sort de la machine.
# gemini = Gemini Embedding 2 via l'API Google (les contenus sont envoyés à Google).
EMBEDDERS=gemma,peav,gemini,coverhunter,hum2song
# clap : écarté de la fusion par défaut (≈ 0 sur T1/T3/T4/T6a le 29/10) ; à remettre pour comparaison

# ---- Données ----
DATA_DIR=./data

# ---- Extraits audio (30 s) ----
# memory : l'audio n'est jamais écrit sur disque (embeddings et empreintes calculés à la volée) ;
# disk   : cache dans data/previews/ — uniquement si les conditions d'utilisation le permettent (voir README).
PREVIEW_STORAGE=memory

# ---- Hugging Face (modèles à accès restreint : SAM Audio) ----
# Jeton « read » créé sur https://huggingface.co/settings/tokens, après acceptation des conditions
# du modèle (facebook/sam-audio-*). Chargé dans l'environnement par core.config (jamais commité).
HF_TOKEN=
