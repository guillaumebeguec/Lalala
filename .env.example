# ---- LLM (Llama via Ollama, OpenAI-compatible client) ----
# Ollama exposes an OpenAI-compatible API under /v1. For a hosted Llama API,
# change base_url, model and key.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=ollama

# ---- Gemini Embedding 2 (one embedder among others, can be disabled) ----
USE_GEMINI=true
GEMINI_API_KEY=
GEMINI_DIM=768

# ---- Web search (tavily | brave) ----
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=

# ---- Active embedders (subset of: clap, peav, gemma, gemini, coverhunter, hum2song) ----
# gemma = EmbeddingGemma 2 (google/embeddinggemma-2), open weights, runs locally: nothing leaves the machine.
# gemini = Gemini Embedding 2 through the Google API (content is sent to Google).
EMBEDDERS=gemma,peav,gemini,coverhunter,hum2song
# clap: dropped from the default fusion (≈ 0 on T1/T3/T4/T6a); add it back for comparison

# ---- Data ----
DATA_DIR=./data

# ---- Audio previews (30 s) ----
# memory : audio is never written to disk (embeddings and fingerprints computed on the fly);
# disk   : cache in data/previews/ — only if the provider's terms of use allow it (see README).
PREVIEW_STORAGE=memory

# ---- Hugging Face (gated models: SAM Audio) ----
# "read" token created on https://huggingface.co/settings/tokens after accepting the model terms
# (facebook/sam-audio-*). Loaded into the environment by core.config (never committed).
HF_TOKEN=

# ---- SAM Audio (music isolation, phase 9) ----
# auto: MLX port (data/raw/sam_audio/venv_mlx) then official package (data/raw/sam_audio/venv); off: step skipped.
SAM_AUDIO_ENGINE=auto
