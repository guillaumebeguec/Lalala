# ---- LLM (Llama via Ollama, client OpenAI-compatible) ----
# Ollama expose une API OpenAI-compatible sur /v1. Pour une API Llama hébergée,
# changer base_url, modèle et clé.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=ollama

# ---- Gemini Embedding 2 (un embedder parmi d'autres, désactivable) ----
USE_GEMINI=true
GEMINI_API_KEY=
GEMINI_DIM=768

# ---- Recherche web (tavily | brave) ----
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=

# ---- Embedders actifs (sous-ensemble de : clap, peav, gemini) ----
EMBEDDERS=clap,peav,gemini

# ---- Données ----
DATA_DIR=./data
